[Unit]
Description=Acer Swift SF514-52T ALC255 headset-mic pin reconfig
Documentation=https://bugzilla.kernel.org/show_bug.cgi?id=219654
DefaultDependencies=no
After=sysinit.target systemd-udev-settle.service
Before=sound.target multi-user.target
ConditionPathExists=/sys/class/sound

[Service]
Type=oneshot
RemainAfterExit=yes
# init_t cannot execute a file labeled alsa_var_lib_t (Permission
# denied, status 203/EXEC). /usr/bin/bash is shell_exec_t and reads
# the script as data.
ExecStart=/usr/bin/bash /var/lib/alsa/sf514-audio/apply-headset-pins.sh

[Install]
WantedBy=multi-user.target
